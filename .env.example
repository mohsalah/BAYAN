# Copy to .env and fill in. Never commit .env.
# Reader agent (M8). Without a real key the reader endpoint answers 503 "not configured".
ANTHROPIC_API_KEY=your-key-here
BAYAN_MODEL_READER=claude-sonnet-5-5
BAYAN_READER_EFFORT=high
BAYAN_READINGS_PER_HOUR=20
OPENALEX_API_KEY=your-openalex-key-here
CONTACT_EMAIL=you@example.com
# Random string (16+ characters) from which the key encrypting stored user publisher keys is derived
# (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))").
# If it is unset or still a placeholder, saving keys is refused (HTTP 503); nothing is stored in
# plaintext. Changing it later makes saved keys unreadable: users see "needs re-entry".
APP_SECRET_KEY=change-me
BAYAN_DATABASE_PATH=data/app.sqlite
BAYAN_PDF_ROOT=pdfs
BAYAN_DOWNLOADS_PER_HOUR=100
# Translator (M24): a LibreTranslate-compatible server; leave empty = "translator not configured"
BAYAN_TRANSLATE_URL=
BAYAN_TRANSLATE_API_KEY=
BAYAN_TRANSLATE_MAX_CHARS=20000
BAYAN_TRANSLATIONS_PER_HOUR=30

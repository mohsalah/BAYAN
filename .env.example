# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here
OPENALEX_API_KEY=your-openalex-key-here
CONTACT_EMAIL=you@example.com
# Random string used to encrypt stored user credentials (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))")
APP_SECRET_KEY=change-me
BAYAN_DATABASE_PATH=data/app.sqlite
BAYAN_PDF_ROOT=pdfs
BAYAN_DOWNLOADS_PER_HOUR=100

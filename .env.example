# Copy to .env and fill in. Never commit .env.
# Reader agent (M8). Without a real key the reader endpoint answers 503 "not configured".
ANTHROPIC_API_KEY=your-key-here
BAYAN_MODEL_READER=claude-sonnet-5-5
BAYAN_READER_EFFORT=high
BAYAN_READINGS_PER_HOUR=20
# Planner agent (M3), same key.
BAYAN_MODEL_PLANNER=claude-sonnet-5-5
BAYAN_PLANNER_EFFORT=medium
BAYAN_PLANS_PER_HOUR=10
# Concept mapper (M17), same key.
BAYAN_MODEL_CONCEPTS=claude-sonnet-5-5
BAYAN_CONCEPTS_EFFORT=high
BAYAN_CONCEPT_READINGS_PER_HOUR=20
BAYAN_CONCEPT_MERGES_PER_HOUR=10
OPENALEX_API_KEY=your-openalex-key-here
CONTACT_EMAIL=you@example.com
# Random string (16+ characters) from which the key encrypting stored user publisher keys is derived
# (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))").
# If it is unset or still a placeholder, saving keys is refused (HTTP 503); nothing is stored in
# plaintext. Changing it later makes saved keys unreadable: users see "needs re-entry".
APP_SECRET_KEY=change-me
BAYAN_DATABASE_PATH=data/app.sqlite
BAYAN_PDF_ROOT=pdfs
BAYAN_DOWNLOADS_PER_HOUR=100
# Saved local-library searches per user per hour (M30). Nothing is sent to any library.
BAYAN_LOCAL_SEARCHES_PER_HOUR=120
# OpenAlex ID lookups per user per hour for collection foundations (M31).
BAYAN_LOOKUPS_PER_HOUR=20
# Collection refresh (M32). Citation counts older than this many days are "stale" and are
# refreshed by POST /api/collections/{id}/refresh.
BAYAN_CITATIONS_MAX_AGE_DAYS=30
# Refresh collections automatically when their last refresh is older than this many days
# (0 = off), each with this request budget. Automatic refreshes spend OpenAlex credits.
BAYAN_AUTO_REFRESH_DAYS=0
BAYAN_AUTO_REFRESH_MAX_REQUESTS=20
# Request budgets one user may start per hour with manual refreshes.
BAYAN_REFRESH_REQUESTS_PER_HOUR=200
# Translator (M24): a LibreTranslate-compatible server; leave empty = "translator not configured"
BAYAN_TRANSLATE_URL=
BAYAN_TRANSLATE_API_KEY=
BAYAN_TRANSLATE_MAX_CHARS=20000
BAYAN_TRANSLATIONS_PER_HOUR=30
